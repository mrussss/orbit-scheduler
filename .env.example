APP_ENV=development
LOG_LEVEL=info
HTTP_ADDR=:8080
GRPC_ADDR=:9090
METRICS_ADDR=:9091
DATABASE_URL=postgres://orbit:orbit@localhost:5432/orbit?sslmode=disable
GORM_MAX_OPEN_CONNS=10
GORM_MAX_IDLE_CONNS=5
PGX_MAX_CONNS=20
PGX_MIN_CONNS=2
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
KAFKA_BROKERS=localhost:9092
KAFKA_TASK_EVENTS_TOPIC=orbit.task-events.v1
KAFKA_TASK_EVENTS_DLQ_TOPIC=orbit.task-events.dlq.v1
TOKEN_PEPPER=replace-with-at-least-32-characters
ADMIN_TOKEN=replace-with-an-independent-32-character-admin-token
HTTP_REQUEST_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576
WORKER_NAME=local-worker
WORKER_METRICS_ADDR=:9092
WORKER_CAPACITY=4
WORKER_TASK_TYPES=mock,http
WORKER_GRACE_PERIOD=30s
WORKER_FETCH_INTERVAL=500ms
WORKER_HEARTBEAT_INTERVAL=5s
WORKER_LEASE_DURATION=30s
WORKER_RENEW_INTERVAL=10s
HTTP_EXECUTOR_ALLOWED_HOSTS=example.com
HTTP_EXECUTOR_REQUEST_TIMEOUT=10s
HTTP_EXECUTOR_MAX_REQUEST_BYTES=262144
HTTP_EXECUTOR_MAX_RESPONSE_BYTES=1048576
HTTP_EXECUTOR_MAX_REDIRECTS=3

# Reliable LLM Executor. Add llm to WORKER_TASK_TYPES to enable it.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://provider.example/v1
LLM_API_KEY=replace-with-provider-api-key
LLM_ALLOWED_MODELS=approved-model
LLM_REQUEST_TIMEOUT=45s
LLM_DIAL_TIMEOUT=5s
LLM_TLS_HANDSHAKE_TIMEOUT=5s
LLM_MAX_PROMPT_BYTES=262144
LLM_MAX_RESPONSE_BYTES=1048576
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_CONCURRENCY=4
# Integer microunits per one million tokens. Empty means token usage is
# recorded but estimated cost is omitted.
LLM_COST_TABLE_JSON={}
LLM_LOG_CONTENT=false
LLM_TOOL_CALLING_ENABLED=false
LLM_MAX_TOOL_ROUNDS=3

# Independent MySQL lab only (not used by production processes).
MYSQL_LAB_DSN=orbit:orbit@tcp(localhost:3306)/orbit_lab?parseTime=true
MYSQL_LAB_MAX_OPEN_CONNS=10
MYSQL_LAB_MAX_IDLE_CONNS=5
